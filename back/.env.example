DATABASE_URL="postgresql://flashify_user:change-me@localhost/flashify_db"
REDIS_URL="redis://redis:6379/0"

# Configurações do JWT
SECRET_KEY="generate-a-unique-secret-for-each-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/gcp-credentials.json"
GOOGLE_API_KEY="your-google-api-key"

# Provedor de IA (Gemini permanece ativo)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=90

# OpenAI (opcional; Gemini permanece como padrão até o rollout)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Proteções de autenticação e upload
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
MAX_UPLOAD_SIZE_MB=10

# Configurações de E-mail
MAIL_USERNAME="seu-email@gmail.com"
MAIL_PASSWORD="sua-senha-de-app"
MAIL_FROM="noreply@flashify.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# URLs para links nos e-mails
FRONTEND_URL="http://localhost:4000"

# Links de redes sociais
WHATSAPP_LINK="https://wa.me/5592000000000"
TELEGRAM_LINK="https://t.me/flashify"
